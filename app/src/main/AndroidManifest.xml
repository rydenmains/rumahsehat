<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kebijakan izin MINIMAL (least privilege):
         - READ/WRITE_EXTERNAL_STORAGE & CAMERA TIDAK dipakai (kamera via
           ActivityResultContracts.TakePicture = intent eksternal, tanpa izin;
           galeri via Photo Picker PickVisualMedia = tanpa izin, fallback GetContent).
         - Cukup INTERNET + fitur kamera opsional. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".RumahSehatApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RumahSehat">

        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RumahSehat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ReviewActivity"
            android:exported="false"
            android:label="@string/review_title" />

        <activity
            android:name=".ui.result.ResultActivity"
            android:exported="false"
            android:label="@string/result_title" />

    </application>

</manifest>
