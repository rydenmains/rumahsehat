<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RumahSehat" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/emerald_accent</item>
        <item name="android:fontFamily">@font/nunito_family</item>
        <item name="android:windowBackground">@color/background_warm</item>
        <item name="android:statusBarColor">@color/background_warm</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.RumahSehat.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>

    <style name="Widget.RumahSehat.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="AlertDialogCustom" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:fontFamily">@font/nunito_family</item>
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background_warm</item>
    </style>
</resources>
