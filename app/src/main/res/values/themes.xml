<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RumahSehat" parent="Theme.Material3.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/emerald_accent</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="android:windowBackground">@color/background_warm</item>
        <item name="android:statusBarColor">@color/background_warm</item>
        <item name="android:navigationBarColor">@color/background_warm</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Widget.RumahSehat.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="cardBackgroundColor">@color/surface_lowest</item>
    </style>

    <style name="Widget.RumahSehat.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.RumahSehat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">100dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="AlertDialogCustom" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="android:fontFamily">@font/inter_family</item>
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/background_warm</item>
    </style>
</resources>