<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_warm">

    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/greeting_welcome"
        android:textAppearance="@style/TextAppearance.RumahSehat.Label.Large"
        android:textColor="@color/forest_green" />

    <TextView
        android:id="@+id/tvHomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.RumahSehat.Headline.Small"
        android:textColor="@color/on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/greeting_subtitle"
        android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
        android:textColor="@color/on_surface_variant" />

    <!-- Sync Status -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llSyncBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="@color/surface_low"
        app:cardCornerRadius="@dimen/dimen_card_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/outline_variant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivSyncIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_number_badge"
                android:backgroundTint="@color/secondary_container"
                android:padding="8dp"
                android:src="@drawable/ic_sync"
                app:tint="@color/forest_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_banner_title"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Label.Large"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tvPendingInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSyncNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sync_now"
                android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
                android:textColor="@color/forest_green"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Start Inspection -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnStartNew"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/forest_green"
        app:cardCornerRadius="@dimen/dimen_card_radius"
        app:cardElevation="3dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="-20dp"
                android:layout_marginBottom="-20dp"
                android:src="@drawable/ic_add"
                android:alpha="0.2"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_number_badge"
                    android:backgroundTint="@color/overlay_on_primary"
                    android:padding="8dp"
                    android:src="@drawable/ic_assignment"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/start_inspection"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Title.Medium"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/cta_inspeksi_sub"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
                    android:textColor="@color/on_primary_soft" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- History -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnViewHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface_low"
        app:cardCornerRadius="@dimen/dimen_card_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/outline_variant"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_number_badge"
                android:backgroundTint="@color/secondary_container"
                android:padding="8dp"
                android:src="@drawable/ic_history"
                app:tint="@color/forest_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/cta_history"
                android:textAppearance="@style/TextAppearance.RumahSehat.Title.Medium"
                android:textColor="@color/on_surface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cta_history_sub"
                android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Summary -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface_lowest"
        app:cardCornerRadius="@dimen/dimen_card_radius"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/outline_variant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_title"
                android:textAppearance="@style/TextAppearance.RumahSehat.Label.Large"
                android:textColor="@color/on_surface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_completed"
                        android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/tvTodayCompleted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textAppearance="@style/TextAppearance.RumahSehat.Headline.Medium"
                        android:textColor="@color/forest_green" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/outline_variant"
                    android:layout_marginHorizontal="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_pending"
                        android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
                        android:textColor="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/tvTodayPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="1"
                        android:textAppearance="@style/TextAppearance.RumahSehat.Headline.Medium"
                        android:textColor="@color/on_surface" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
