<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@color/surface_lowest"
    android:elevation="8dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav_tab"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_nav_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            app:tint="@color/bottom_nav_item_color"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/tv_nav_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textSize="12sp"
            android:textColor="@color/bottom_nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_inspect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav_tab"
        android:paddingVertical="8dp"
        android:layout_marginHorizontal="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_nav_inspect"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_assignment"
            app:tint="@color/bottom_nav_item_color"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/tv_nav_inspect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_inspect"
            android:textSize="12sp"
            android:textColor="@color/bottom_nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_bottom_nav_tab"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/iv_nav_history"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_history"
            app:tint="@color/bottom_nav_item_color"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/tv_nav_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_history"
            android:textSize="12sp"
            android:textColor="@color/bottom_nav_item_color"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
