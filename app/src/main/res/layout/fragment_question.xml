<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_edge_margin"
        android:paddingBottom="@dimen/dimen_stack_lg">

        <!-- Header soal: badge section + judul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badgeNumber"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_number_badge"
                android:gravity="center"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_stack_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuestionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Title.Large"
                    android:textColor="@color/on_surface"
                    tools:text="Kondisi Langit-langit (Plafon)" />

                <TextView
                    android:id="@+id/tvQuestionNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_stack_sm"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
                    android:textColor="@color/forest_green"
                    tools:text="PERTANYAAN 1 DARI 17" />
            </LinearLayout>
        </LinearLayout>

        <!-- Banner transisi section: baris teks tipis, hanya di soal pertama (1.1/2.1/3.1) -->
        <TextView
            android:id="@+id/tvSectionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_md"
            android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
            android:textColor="@color/forest_green"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="II · SARANA SANITASI"
            tools:visibility="visible" />

        <!-- Kartu jawaban -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RumahSehat.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimen_edge_margin">

                <RadioGroup
                    android:id="@+id/rgOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.RumahSehat.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_stack_md"
                    android:hint="@string/notes_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status foto (hanya di soal pertama section) -->
        <TextView
            android:id="@+id/tvPhotoCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_lg"
            android:textAppearance="@style/TextAppearance.RumahSehat.Label.Large"
            android:textColor="@color/on_surface"
            android:visibility="gone"
            tools:text="Foto 1: Tampak Depan Rumah"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvPhotoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_sm"
            android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone"
            tools:text="Foto belum diambil. Ketuk tombol kamera (kanan bawah) untuk membuka kamera."
            tools:visibility="visible" />
    </LinearLayout>
</ScrollView>