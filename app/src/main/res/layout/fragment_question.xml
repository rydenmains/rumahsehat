<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dimen_edge_margin"
        android:paddingBottom="@dimen/dimen_stack_lg">

        <!-- Transition banner: first question of a section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvSectionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/secondary_container"
            app:cardCornerRadius="@dimen/dimen_card_radius"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/dimen_stack_md">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_number_badge" />

                <TextView
                    android:id="@+id/tvSectionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dimen_stack_md"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Title.Medium"
                    android:textColor="@color/forest_green"
                    tools:text="II. SARANA SANITASI" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section aktif (uppercase, primary) -->
        <TextView
            android:id="@+id/tvSectionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_sm"
            android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
            android:textColor="@color/forest_green"
            tools:text="KOMPONEN RUMAH" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badgeNumber"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_number_badge"
                android:gravity="center"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_stack_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuestionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Title.Large"
                    android:textColor="@color/on_surface"
                    tools:text="Kondisi Langit-langit (Plafon)" />

                <TextView
                    android:id="@+id/tvQuestionNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_stack_sm"
                    android:textAppearance="@style/TextAppearance.RumahSehat.Label.Medium"
                    android:textColor="@color/forest_green"
                    tools:text="PERTANYAAN 1 DARI 17" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_sm"
            android:text="@string/level_hint"
            android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RumahSehat.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dimen_edge_margin">

                <RadioGroup
                    android:id="@+id/rgOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.RumahSehat.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimen_stack_md"
                    android:hint="@string/notes_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/cbApplicable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="@string/applicable"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvPhotoCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_lg"
            android:textAppearance="@style/TextAppearance.RumahSehat.Title.Medium"
            android:textColor="@color/on_surface"
            android:visibility="gone"
            tools:text="Dokumentasi Tampak Depan Rumah (Foto 1)" />

        <TextView
            android:id="@+id/tvPhotoHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_sm"
            android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
            android:textColor="@color/on_surface_variant"
            android:visibility="gone"
            tools:text="Foto belum diambil. Ketuk tombol di bawah untuk membuka kamera." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoto"
            style="@style/Widget.RumahSehat.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_stack_sm"
            android:minHeight="56dp"
            android:textColor="@color/on_primary"
            android:visibility="gone"
            app:backgroundTint="@color/forest_green"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/dimen_stack_sm"
            app:iconTint="@color/on_primary"
            tools:text="Ambil Foto" />
    </LinearLayout>
</ScrollView>