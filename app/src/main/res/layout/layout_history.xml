<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutHistory"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background_warm"
    android:visibility="gone">

    <TextView
        android:id="@+id/tvHistoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_title"
        android:textAppearance="@style/TextAppearance.RumahSehat.Headline.Small"
        android:textColor="@color/on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cta_history_sub"
        android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
        android:textColor="@color/on_surface_variant" />

    <!-- Search Bar -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/surface_low"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeWidth="1dp"
        app:boxStrokeColor="@color/outline_variant"
        app:boxStrokeWidthFocused="1dp"
        app:hintEnabled="false"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="@color/on_surface_variant">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/history_search_hint"
            android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
            android:textColorHint="@color/on_surface_variant"
            android:textColor="@color/on_surface"
            android:paddingVertical="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Filters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <com.google.android.material.chip.Chip
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter"
            app:chipIcon="@android:drawable/ic_menu_sort_by_size"
            app:chipIconTint="@color/on_surface"
            style="@style/Widget.Material3.Chip.Assist" />

        <com.google.android.material.chip.Chip
            android:id="@+id/btnSyncAllHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/sync_now"
            app:chipIcon="@drawable/ic_sync"
            app:chipIconTint="@color/forest_green"
            app:chipBackgroundColor="@color/secondary_container"
            android:textColor="@color/forest_green"
            style="@style/Widget.Material3.Chip.Assist" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_number_badge"
            android:backgroundTint="@color/secondary_container"
            android:contentDescription="@string/history_title"
            android:padding="18dp"
            android:src="@drawable/ic_history"
            app:tint="@color/forest_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/history_empty"
            android:textAppearance="@style/TextAppearance.RumahSehat.Title.Medium"
            android:textColor="@color/on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/history_empty_sub"
            android:textAppearance="@style/TextAppearance.RumahSehat.Body.Medium"
            android:textColor="@color/on_surface_variant" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAssessments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
